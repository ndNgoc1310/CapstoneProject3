
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.clk}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.rst_n}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.valid_in}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.lam_in[15:0]}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.ome_in[15:0]}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.err_flg}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.l_val_der[9:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.o_val[9:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.sop_out}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.valid_out}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.ready}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.error}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.CHIEN_CTRL.state_current[2:0]}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.cnt_end}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.init}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.reg_en}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.DUT.cnt_en}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.test_idx}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.pass_cnt}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.fail_cnt}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_dec_chien_tb.mismatch}]}
	} ]]
waveform format $id -namecolor #00ff00

waveform xview limits 0 250ns

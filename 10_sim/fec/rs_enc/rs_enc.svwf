
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.clk}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.rst_n}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.sop_in}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.vld_in}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.data_in[9:0]}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.sop_out}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.vld_out}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Control_Unit.sys_rdy}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Control_Unit.error}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.data_out[9:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Counter.count_out[9:0]}]}
	} ]]
waveform format $id -radix %d -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Counter.count_parity}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Counter.count_done}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Control_Unit.state_current[2:0]}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Control_Unit.reg_en}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Control_Unit.control}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.DUT.Control_Unit.count_en}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.test_idx}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.pass_cnt}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.fail_cnt}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_enc_tb.mismatch}]}
	} ]]
waveform format $id -namecolor #00ff00

waveform xview limits 5110.156ns 5275ns

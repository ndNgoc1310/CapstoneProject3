
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {top_tb.rst_n}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {top_tb.clk}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_CTRL.state_cur[2:0]}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.vld_in}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.lam_in[15:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.ome_in[15:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.len_in[4:0]}]}
	} ]]
waveform format $id -radix %d -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_CNT.cnt_out[9:0]}]}
	} ]]
waveform format $id -radix %d -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_CNT.cnt_end}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_CTRL.init}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_CTRL.reg_en}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_LAM.l_val[9:0]}]}
	} ]]
waveform format $id -color #ff00ff -namecolor #ff00ff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_LAM.err_flg}]}
	} ]]
waveform format $id -color #ff00ff -namecolor #ff00ff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_LAM.l_val_der[9:0]}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.CHIEN_OME.o_val_out[15:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
waveform hierarchy expand $id
set id2 [lindex [waveform hierarchy content $id] 0]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 1]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 2]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 3]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 4]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 5]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 6]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 7]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 8]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 9]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 10]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 11]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 12]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 13]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 14]
waveform format $id2 -color #ff0099 -namecolor #ff0099
set id2 [lindex [waveform hierarchy content $id] 15]
waveform format $id2 -color #ff0099 -namecolor #ff0099
waveform hierarchy collapse $id
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.sop_out}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.vld_out}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.sys_rdy}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {top_tb.DUT.Decoder.Chien.sys_err}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff

waveform xview limits 45016.995ns 45266.995ns

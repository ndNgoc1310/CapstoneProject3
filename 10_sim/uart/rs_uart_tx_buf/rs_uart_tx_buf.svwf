
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.clk}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.rst_n}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.baud_clk}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.gbx_bit_cnt}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.uart_tx_done}]}
	} ]]
waveform format $id -namecolor #00ff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.gbx_tx_rdy}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.rs_tx_vld}]}
	} ]]
waveform format $id -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.rs_tx_dat[9:0]}]}
	} ]]
waveform format $id -radix %d -color #00ffff -namecolor #00ffff
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.state_cur[1:0]}]}
	} ]]
waveform format $id -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.w_cnt_final}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.r_cnt_final}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.w_en}]}
	} ]]
waveform format $id -color #ff00ff -namecolor #ff00ff
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.r_en}]}
	} ]]
waveform format $id -color #ff00ff -namecolor #ff00ff
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.w_cnt_clr}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.r_cnt_clr}]}
	} ]]
waveform format $id -color #ff9900 -namecolor #ff9900
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.w_cnt_dat[9:0]}]}
	} ]]
waveform format $id -radix %d -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.r_cnt_dat[9:0]}]}
	} ]]
waveform format $id -radix %d -color #ff0099 -namecolor #ff0099
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.buf_tx_vld}]}
	} ]]
waveform format $id -color #ff00ff -namecolor #ff00ff
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.buf_tx_dat[9:0]}]}
	} ]]
waveform format $id -radix %d -color #ff00ff -namecolor #ff00ff
set id [waveform add -signals [subst  {
	{[format {rs_uart_tx_buf_tb.dut.fifo[1023:0]}]}
	} ]]
waveform format $id -color #ffff00 -namecolor #ffff00
waveform hierarchy expand $id
set id2 [lindex [waveform hierarchy content $id] 0]
waveform format $id2 -radix %d
set id2 [lindex [waveform hierarchy content $id] 1]
waveform format $id2 -radix %d
set id2 [lindex [waveform hierarchy content $id] 2]
waveform format $id2 -radix %d
